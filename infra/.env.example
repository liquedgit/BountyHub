# Copy to infra/.env and change every value before first run:
#   cp infra/.env.example infra/.env
# Generate a JWT secret with: openssl rand -hex 32

POSTGRES_USER=bountyhub
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=bountyhub

# Signs the auth cookie. Must be long and random.
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# Set to true only when serving over HTTPS.
AUTH_COOKIE_SECURE=false

# --- Public access via Cloudflare Tunnel (see README "Public access") ---
# Managed by `scripts/stack.sh tunnel up|down`; "on" closes the LAN URL and sets
# the Secure cookie flag.
BOUNTYHUB_TUNNEL=off

# Named tunnel only: token from the Cloudflare Zero Trust dashboard. Leave empty
# to use a quick tunnel (random trycloudflare.com URL).
TUNNEL_TOKEN=

# Named tunnel only: the public hostname configured for the tunnel, e.g. hub.example.com
PUBLIC_HOSTNAME=
