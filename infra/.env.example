# Copy to infra/.env and change every value before first run:
#   cp infra/.env.example infra/.env
# Generate a JWT secret with: openssl rand -hex 32

POSTGRES_USER=bountyhub
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=bountyhub

# Signs the auth cookie. Must be long and random.
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# Set to true only when serving over HTTPS.
AUTH_COOKIE_SECURE=false
